# syntax=docker/dockerfile:1

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MODEL_CHECKPOINT=/app/checkpoints/classifier_v1.pt

WORKDIR /app

COPY requirements/serve.txt /app/requirements/serve.txt
RUN pip install --upgrade pip && pip install -r /app/requirements/serve.txt \
    && useradd --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/checkpoints \
    && chown -R appuser:appuser /app

COPY src/ /app/src/
RUN chown -R appuser:appuser /app/src

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2).read()"

CMD ["uvicorn", "src.serve:app", "--host", "0.0.0.0", "--port", "8080"]
